<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Camera Preview -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Info Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/overlay_dark"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCameraInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PureShot"
            android:textColor="@color/on_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvRawIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZERO PROCESSING"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/badge_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Manual Controls Panel -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/overlay_dark"
        android:padding="16dp"
        android:layout_marginBottom="100dp">

        <!-- ISO Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="ISO"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <SeekBar
                android:id="@+id/seekBarIso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="10"
                android:progressTint="@color/slider_active"
                android:thumbTint="@color/accent_blue" />

            <TextView
                android:id="@+id/tvIsoValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:gravity="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Shutter Speed Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="SS"
                android:textColor="@color/accent_orange"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <SeekBar
                android:id="@+id/seekBarShutter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/slider_active"
                android:thumbTint="@color/accent_orange" />

            <TextView
                android:id="@+id/tvShutterValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="1/100"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:gravity="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- White Balance Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="WB"
                android:textColor="@color/secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <SeekBar
                android:id="@+id/seekBarWb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/slider_active"
                android:thumbTint="@color/secondary" />

            <TextView
                android:id="@+id/tvWbValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="5500K"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:gravity="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Capture Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:elevation="8dp">

        <!-- Manual Mode Toggle -->
        <ImageButton
            android:id="@+id/btnManualMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_manual"
            android:background="@drawable/circle_button_secondary"
            android:contentDescription="Manuel Mod"
            android:layout_marginEnd="40dp" />

        <!-- Shutter Button -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_shutter"
            android:background="@drawable/shutter_button"
            android:contentDescription="Çek"
            android:elevation="4dp" />

        <!-- Gallery Button -->
        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_gallery"
            android:background="@drawable/circle_button_secondary"
            android:contentDescription="Galeri"
            android:layout_marginStart="40dp" />
    </LinearLayout>

    <!-- Toast/Status Message -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/toast_background"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
