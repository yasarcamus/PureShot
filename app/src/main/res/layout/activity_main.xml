<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Camera Preview -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Grid Overlay -->
    <View
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grid_overlay"
        android:visibility="gone" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/gradient_top"
        android:gravity="center_vertical">

        <!-- Camera Info -->
        <TextView
            android:id="@+id/tvCameraInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PureShot"
            android:textColor="@color/on_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Grid Toggle -->
        <ImageButton
            android:id="@+id/btnGrid"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_grid"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Grid"
            android:alpha="0.7"
            android:layout_marginEnd="8dp" />

        <!-- Camera Switch -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_switch_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kamera Değiştir"
            android:alpha="0.7" />
    </LinearLayout>

    <!-- Center Focus Indicator -->
    <View
        android:id="@+id/focusIndicator"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:background="@drawable/focus_indicator"
        android:visibility="gone" />

    <!-- Zoom Indicator -->
    <TextView
        android:id="@+id/tvZoomLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="200dp"
        android:text="1.0x"
        android:textColor="@color/on_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/zoom_badge"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone" />

    <!-- Manual Controls Panel -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/gradient_bottom"
        android:padding="16dp"
        android:paddingBottom="120dp">

        <!-- Zoom Control -->
        <LinearLayout
            android:id="@+id/zoomControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="20sp"
                android:gravity="center" />

            <SeekBar
                android:id="@+id/seekBarZoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent_blue"
                android:thumbTint="@color/accent_blue" />

            <TextView
                android:id="@+id/tvZoomValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:gravity="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- ISO Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            android:id="@+id/isoControl">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="ISO"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold" />

            <SeekBar
                android:id="@+id/seekBarIso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="10"
                android:progressTint="@color/slider_active"
                android:thumbTint="@color/accent_blue" />

            <TextView
                android:id="@+id/tvIsoValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:gravity="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Shutter Speed Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            android:id="@+id/shutterControl">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="SS"
                android:textColor="@color/accent_orange"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold" />

            <SeekBar
                android:id="@+id/seekBarShutter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/slider_active"
                android:thumbTint="@color/accent_orange" />

            <TextView
                android:id="@+id/tvShutterValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="1/100"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:gravity="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- White Balance Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:id="@+id/wbControl">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="WB"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold" />

            <SeekBar
                android:id="@+id/seekBarWb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/slider_active"
                android:thumbTint="@color/secondary" />

            <TextView
                android:id="@+id/tvWbValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="5500K"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:gravity="end"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Capture Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:elevation="8dp"
        android:paddingHorizontal="24dp">

        <!-- Last Photo Thumbnail -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="32dp">

            <ImageView
                android:id="@+id/imgLastPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/thumbnail_border"
                android:contentDescription="Son Fotoğraf" />
        </FrameLayout>

        <!-- Shutter Button -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shutter_button_outer" />

            <ImageButton
                android:id="@+id/btnCapture"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_button"
                android:contentDescription="Çek" />
        </FrameLayout>

        <!-- Manual Mode Toggle -->
        <ImageButton
            android:id="@+id/btnManualMode"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_manual"
            android:background="@drawable/circle_button_secondary"
            android:contentDescription="Manuel Mod"
            android:layout_marginStart="32dp"
            android:alpha="0.6"
            android:padding="14dp" />
    </LinearLayout>

    <!-- Status Toast -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/toast_background"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        android:elevation="10dp"
        android:visibility="gone" />

</FrameLayout>
