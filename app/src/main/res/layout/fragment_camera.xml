<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Camera Preview -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Grid Overlay -->
    <View
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/grid_lines"
        android:visibility="gone" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@drawable/gradient_top"
        android:gravity="center_vertical">

        <!-- Mode Indicator -->
        <TextView
            android:id="@+id/tvModeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTO"
            android:textColor="@color/secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/mode_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Grid Toggle -->
        <ImageButton
            android:id="@+id/btnGrid"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_grid"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:alpha="0.6" />

        <!-- Camera Switch -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_switch_camera"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:alpha="0.8" />
    </LinearLayout>

    <!-- Zoom Level Display -->
    <TextView
        android:id="@+id/tvZoomLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="100dp"
        android:text="1.0x"
        android:textColor="@color/on_primary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/zoom_badge"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:visibility="gone" />

    <!-- Mode Selector -->
    <HorizontalScrollView
        android:id="@+id/modeSelectorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="180dp"
        android:scrollbars="none"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/modeSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btnModeAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO"
                android:textColor="@color/secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/btnModePro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRO"
                android:textColor="#88FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/btnModePortrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PORTRAIT"
                android:textColor="#88FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/btnModeNight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NIGHT"
                android:textColor="#88FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

            <TextView
                android:id="@+id/btnModeHdr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HDR"
                android:textColor="#88FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Controls Panel (Pro Mode) -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="120dp"
        android:orientation="vertical"
        android:background="@drawable/gradient_bottom"
        android:padding="16dp"
        android:visibility="gone">

        <!-- ISO -->
        <include layout="@layout/control_slider"
            android:id="@+id/isoControl" />

        <!-- Shutter -->
        <include layout="@layout/control_slider_shutter"
            android:id="@+id/shutterControl" />

        <!-- White Balance -->
        <include layout="@layout/control_slider_wb"
            android:id="@+id/wbControl" />
    </LinearLayout>

    <!-- Bottom Capture Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:elevation="8dp"
        android:paddingHorizontal="24dp">

        <!-- Last Photo Thumbnail -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/imgLastPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/thumbnail_border" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Shutter Button -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shutter_button_outer" />

            <ImageButton
                android:id="@+id/btnCapture"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_button" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- LUT/Filter -->
        <ImageButton
            android:id="@+id/btnLut"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_lut"
            android:background="@drawable/circle_button_secondary"
            android:padding="14dp" />
    </LinearLayout>

    <!-- Status Toast -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/toast_background"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:textColor="@color/on_primary"
        android:textSize="14sp"
        android:elevation="16dp"
        android:visibility="gone" />

</FrameLayout>
